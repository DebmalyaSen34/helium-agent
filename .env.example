ENVIRONMENT=dev

# API keys and URLs
LLM_API_KEY=llm-api-key
LLM_API_URL=llm-api-url
LLM_MODEL=llm-model

# Local model endpoints from inside Docker
HELIUM_RAG_SERVICE_URL=http://rag_service:8765
HELIUM_RAG_HOST=0.0.0.0
HELIUM_RAG_PORT=8765

# Browser fetching
USE_PLAYWRIGHT=true # or false to disable browser fetching
PLAYWRIGHT_HEADLESS=true # or false to see the browser in action (useful for debugging)